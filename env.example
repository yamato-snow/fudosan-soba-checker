# このファイルを .env にコピーして値を入れる（.env は gitignore 済み）
#   cp env.example .env

# 不動産情報ライブラリ（reinfolib）のAPIキー。https://www.reinfolib.mlit.go.jp/ で申請する
REINFOLIB_API_KEY=

# 取込対象の市区町村コード5桁をカンマ区切り。先頭が「基準市」（Ring2 の基準）になる。
# 例は東京都千代田区・中央区・港区。自分の対象エリアに置き換える
TARGET_CITIES=13101,13102,13103

# Ring1（近隣地区）= 生活圏の地区コード9桁をカンマ区切り。
# 未設定でも動く（地価が近い同一市内の地区を自動推定する）が、手動設定が常に優先され精度も高い
NEIGHBOR_DISTRICTS=

# フォームで最初に選択される地区コード9桁（任意）
HOME_DISTRICT=

# 取込ウィンドウ（直近何年ぶんの四半期を取るか。既定 3）
INGEST_YEARS=3
